---
import { footerNavigation } from "../../data/navigation";
import { siteConfig } from "../../data/site";
---

<footer class="site-footer" id="contact">
  <div class="container">
    <div class="footer-inner">
      <div class="footer-brand">
        <a href="/" class="footer-logo" aria-label="Cô Năm Spa - Trang chủ"
          ><img
            src="/images/logo.jpg"
            alt="Cô Năm Spa - Tiệm gội đầu và massage"
            loading="lazy"
          /></a
        >
        <p><strong>CÔ NĂM SPA - TIỆM GỘI ĐẦU & MASSAGE</strong></p>
        <div class="footer-location">
          <div class="footer-contact-item">
            <span>📍</span><a
              href={siteConfig.googleMapUrl}
              target="_blank"
              rel="noopener noreferrer">{siteConfig.address}</a
            >
          </div>
          <div class="footer-contact-item">
            <span>🕐</span><span>{siteConfig.openingHours}</span>
          </div>
        </div>
      </div>
      <div class="footer-col">
        <h4>Liên hệ</h4>
        <div class="footer-contact-item">
          <span>📞</span><a href={`tel:${siteConfig.phone}`}>{siteConfig.phoneDisplay}</a>
        </div>
        <div class="footer-contact-item">
          <span>💬</span><a href={siteConfig.zaloUrl} target="_blank" rel="noopener noreferrer"
            >Nhắn tin qua Zalo</a
          >
        </div>
        <div class="footer-contact-item">
          <span>✉</span><a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
        </div>
        <div class="footer-contact-item">
          <span>ⓕ</span><a href={siteConfig.facebookUrl} target="_blank" rel="noopener noreferrer"
            >facebook.com/conamspa</a
          >
        </div>
      </div>
    </div>
    <div class="footer-bottom">
      <p>© {new Date().getFullYear()} Cô Năm Spa. Chốn Bình Yên.</p><nav
        aria-label="Liên kết cuối trang"
      >
        {footerNavigation.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>
    </div>
  </div>
</footer>
