<section
  class="cookie-banner"
  id="cookie-banner"
  aria-label="Lựa chọn cookie"
  role="dialog"
  aria-live="polite"
  hidden
>
  <div>
    <h2>Tuỳ chọn cookie</h2>
    <p>
      Website sử dụng cookie và Google Analytics để đo lường lượt truy cập, cải thiện nội dung và
      trải nghiệm sử dụng. Bạn có thể xem thêm thông tin trong chính sách cookie.
    </p>
    <a href="/chinh-sach-cookie/">Xem chính sách cookie</a>
  </div>
  <div class="cookie-banner__actions">
    <button type="button" class="btn btn-primary" data-cookie-choice="acknowledged">Đã hiểu</button>
  </div>
</section>

<script>
  const storageKey = "conamspa-cookie-consent";
  const banner = document.querySelector<HTMLElement>("#cookie-banner");
  const savedChoice = window.localStorage.getItem(storageKey);

  if (!savedChoice) banner?.removeAttribute("hidden");

  banner?.querySelectorAll<HTMLButtonElement>("[data-cookie-choice]").forEach((button) => {
    button.addEventListener("click", () => {
      window.localStorage.setItem(storageKey, button.dataset.cookieChoice ?? "necessary");
      banner.hidden = true;
    });
  });
</script>
