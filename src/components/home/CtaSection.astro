---
import { siteConfig } from "../../data/site";
---

<section class="cta-section">
  <div class="cta-bg">
    <img src="/images/cta-bg.jpg" alt="" width="1200" height="600" loading="lazy" />
  </div><div class="cta-content">
    <h2>Sẵn Sàng Cho Khoảng Thời Gian Thư Giãn?</h2><p>
