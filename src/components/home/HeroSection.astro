---
import { siteConfig } from "../../data/site";
---

<section class="hero-section" id="sanctuary" aria-label="Cô Năm Spa">
  <div class="hero-bg">
    <img
      src="/images/hero-image.jpg"
      alt="Không gian thực tế tại Cô Năm Spa"
      width="2568"
      height="1926"
      fetchpriority="high"
    />
  </div>
  <div class="hero-content container">
    <div class="hero-badge"><span>🌿</span><span>Chốn Bình Yên · Thành Phố Hồ Chí Minh</span></div>
    <h1 class="hero-title">Nơi Tâm Hồn Được Lắng Nghe Và <em>An Yên</em></h1>
    <p class="hero-desc">
      Dành thời gian nghỉ ngơi với dịch vụ gội đầu thư giãn và massage trong không gian ấm cúng.
    </p>
    <div class="hero-actions">
      <a href={siteConfig.bookingUrl} class="btn btn-primary" data-track="booking_click"
        >Đặt lịch ngay</a
      >
    </div>
  </div>
  <a class="hero-scroll" href="#services" aria-label="Khám phá dịch vụ"><span>Khám phá</span></a>
</section>
