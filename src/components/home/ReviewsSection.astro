---
import { siteConfig } from "../../data/site";

const reviews = [
  {
    name: "Trần Mirabel",
    date: "6 ngày trước",
    image: "/images/review/727620989_898487703277905_5911380024469238575_n.jpg",
  },
  {
    name: "Tuyết Nhi",
    date: "3 ngày trước",
    image: "/images/review/729480412_898487743277901_3695240999200371354_n.jpg",
  },
  {
    name: "Sasha Lake",
    date: "Một tuần trước",
    image: "/images/review/730558923_898487756611233_4795207206999777793_n.jpg",
  },
  {
    name: "Linh Di",
    date: "3 giờ trước",
    image: "/images/review/731442740_898487699944572_361610893878314016_n.jpg",
  },
];
---

<section class="reviews-section" aria-labelledby="reviews-title">
  <div class="container">
    <header class="reviews-header">
      <span class="section-label">Đánh giá từ khách hàng</span>
      <h2 id="reviews-title">Những chia sẻ chân thành</h2>
      <p>Các đánh giá được khách hàng đăng trên Google về trải nghiệm tại Cô Năm Spa.</p>
    </header>
    <div class="reviews-grid">
      {
        reviews.map((review) => (
          <article class="review-card">
            <a
              href={siteConfig.googleMapUrl}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Xem đánh giá của ${review.name} trên Google Maps`}
            >
              <img
                src={review.image}
                alt={`Ảnh chụp đánh giá Google 5 sao của ${review.name}`}
                width="960"
                height="960"
                loading="lazy"
              />
            </a>
            <div class="review-card__meta">
              <>
                <strong>{review.name}</strong>
                <span>{review.date}</span>
              </>
            </div>
          </article>
        ))
      }
    </div>
    <div class="reviews-action">
      <a
        href={siteConfig.googleMapUrl}
        class="btn btn-secondary"
        target="_blank"
        rel="noopener noreferrer">Xem đánh giá trên Google</a
      >
    </div>
  </div>
</section>
