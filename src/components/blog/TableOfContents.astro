---
type Heading = { depth: number; slug: string; text: string };
type Props = { headings: Heading[] };
const { headings } = Astro.props;
const items = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 3);
---

{
  items.length > 0 && (
    <nav class="table-of-contents" aria-label="Mục lục bài viết">
      <>
        <p>Mục lục</p>
        <ol>
          {items.map((item) => (
            <li class:list={{ "table-of-contents__subitem": item.depth === 3 }}>
              <a href={`#${item.slug}`}>{item.text}</a>
            </li>
          ))}
        </ol>
      </>
    </nav>
  )
}
