---
import type { CollectionEntry } from "astro:content";
import { slugify } from "../../utils/slugify";
import { getImageMetadata } from "../../data/image-metadata";
type Props = { post: CollectionEntry<"blog"> };
const { post } = Astro.props;
const publishedAt = new Intl.DateTimeFormat("vi-VN", { dateStyle: "long" }).format(
  post.data.publishedAt,
);
const imageSize = getImageMetadata(post.data.image);
---

<article class="blog-card">
  <a href={`/blog/${post.slug}/`} class="blog-card__image"
    ><img
      src={post.data.image}
      alt={post.data.imageAlt}
      width={imageSize.width}
      height={imageSize.height}
      loading="lazy"
    /></a
  >
  <div class="blog-card__content">
    <p class="blog-card__category">
      <a href={`/danh-muc/${slugify(post.data.category)}/`}>{post.data.category}</a>
    </p><h2><a href={`/blog/${post.slug}/`}>{post.data.title}</a></h2><p>
      {post.data.description}
    </p><div class="blog-card__meta">
      <span>{post.data.author}</span><span>{publishedAt}</span>
    </div><a class="blog-card__link" href={`/blog/${post.slug}/`}
      >Đọc bài viết <span aria-hidden="true">→</span></a
    >
  </div>
</article>
