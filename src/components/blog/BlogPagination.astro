---
type Props = { currentPage: number; totalPages: number };
const { currentPage, totalPages } = Astro.props;
const pageHref = (page: number) => (page === 1 ? "/blog/" : `/blog/page/${page}/`);
---

{
  totalPages > 1 && (
    <nav class="pagination" aria-label="Phân trang bài viết">
      {currentPage > 1 ? (
        <a href={pageHref(currentPage - 1)} rel="prev">
          ← Trang trước
        </a>
      ) : (
        <span aria-hidden="true">← Trang trước</span>
      )}
      <div class="pagination__pages">
        {Array.from({ length: totalPages }, (_, index) => {
          const page = index + 1;
          return (
            <a href={pageHref(page)} aria-current={page === currentPage ? "page" : undefined}>
              {page}
            </a>
          );
        })}
      </div>
      {currentPage < totalPages ? (
        <a href={pageHref(currentPage + 1)} rel="next">
          Trang sau →
        </a>
      ) : (
        <span aria-hidden="true">Trang sau →</span>
      )}
    </nav>
  )
}
