---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import TableOfContents from "../components/blog/TableOfContents.astro";
import AuthorBox from "../components/blog/AuthorBox.astro";
import BlogCard from "../components/blog/BlogCard.astro";
import FaqSection from "../components/blog/FaqSection.astro";
import { slugify } from "../utils/slugify";
import { getImageMetadata } from "../data/image-metadata";

type Heading = { depth: number; slug: string; text: string };
type Props = {
  post: CollectionEntry<"blog">;
  headings: Heading[];
  relatedPosts: CollectionEntry<"blog">[];
};
const { post } = Astro.props;
const { headings, relatedPosts } = Astro.props;
const imageSize = getImageMetadata(post.data.image);
const publishedAt = new Intl.DateTimeFormat("vi-VN", { dateStyle: "long" }).format(
  post.data.publishedAt,
);
const updatedAt = new Intl.DateTimeFormat("vi-VN", { dateStyle: "long" }).format(
  post.data.updatedAt,
);
const articleSchema = {
  "@type": "Article",
  headline: post.data.title,
  description: post.data.description,
  image: new URL(post.data.image, Astro.url.origin).href,
  datePublished: post.data.publishedAt.toISOString(),
  dateModified: post.data.updatedAt.toISOString(),
  author: { "@type": "Organization", name: post.data.author },
  publisher: { "@type": "Organization", name: "Cô Năm Spa" },
};
const faqSchema =
  post.data.faqs.length > 0
    ? {
        "@type": "FAQPage",
        mainEntity: post.data.faqs.map((faq) => ({
          "@type": "Question",
          name: faq.question,
          acceptedAnswer: { "@type": "Answer", text: faq.answer },
        })),
      }
    : null;
const breadcrumbSchema = {
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Trang chủ",
      item: new URL("/", Astro.url.origin).href,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Blog",
      item: new URL("/blog/", Astro.url.origin).href,
    },
    { "@type": "ListItem", position: 3, name: post.data.title, item: Astro.url.href },
  ],
};
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [articleSchema, breadcrumbSchema, ...(faqSchema ? [faqSchema] : [])],
};
---

<BaseLayout
  title={`${post.data.title} | Cô Năm Spa`}
  description={post.data.description}
  image={post.data.image}
>
  <main class="article-page container">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Trang chủ</a><span aria-hidden="true">/</span><a href="/blog/">Blog</a><span
        aria-hidden="true">/</span
      ><span>{post.data.title}</span>
    </nav>
    <article class="article-content">
      <header class="article-header">
        <p class="article-category">
          <a href={`/danh-muc/${slugify(post.data.category)}/`}>{post.data.category}</a>
        </p><h1>{post.data.title}</h1><p class="article-lead">{post.data.description}</p><div
          class="article-meta"
        >
          <span>Tác giả: {post.data.author}</span><span>Đăng: {publishedAt}</span><span
            >Cập nhật: {updatedAt}</span
          >
        </div>
      </header><img
        class="article-featured-image"
        src={post.data.image}
        alt={post.data.imageAlt}
        width={imageSize.width}
        height={imageSize.height}
      /><TableOfContents headings={headings} /><div class="article-body"><slot /></div><FaqSection
        faqs={post.data.faqs}
      /><aside class="article-disclaimer">
        Nội dung mang tính tham khảo về chăm sóc và thư giãn, không thay thế tư vấn, chẩn đoán hoặc
        điều trị y khoa.
      </aside><AuthorBox author={post.data.author} />{
        relatedPosts.length > 0 && (
          <section class="related-posts">
            <>
              <h2>Bài viết liên quan</h2>
              <div class="blog-grid">
                {relatedPosts.map((relatedPost) => (
                  <BlogCard post={relatedPost} />
                ))}
              </div>
            </>
          </section>
        )
      }
    </article>
  </main>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
</BaseLayout>
