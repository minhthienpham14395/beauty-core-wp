---
import BaseLayout from "./BaseLayout.astro";
type Props = { title: string; description: string; updatedAt?: string };
const { title, description, updatedAt } = Astro.props;
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Trang chủ",
      item: new URL("/", Astro.url.origin).href,
    },
    { "@type": "ListItem", position: 2, name: title, item: Astro.url.href },
  ],
};
---

<BaseLayout title={`${title} | Cô Năm Spa`} description={description}>
  <main class="page-content container">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Trang chủ</a><span aria-hidden="true">/</span><span>{title}</span>
    </nav>
    <article>
      <header class="page-header">
        <h1>{title}</h1>{updatedAt && <p>Cập nhật: {updatedAt}</p>}
      </header><slot />
    </article>
  </main>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
</BaseLayout>
