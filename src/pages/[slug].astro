---
import PageLayout from "../layouts/PageLayout.astro";
import { legalPages, type LegalPage } from "../data/legal-pages";

export function getStaticPaths() {
  return legalPages.map((page) => ({ params: { slug: page.slug }, props: { page } }));
}

type Props = { page: LegalPage };
const { page } = Astro.props;
---

<PageLayout title={page.title} description={page.description} updatedAt={page.updatedAt}>
  {
    page.sections.map((section) => (
      <section class="prose-section">
        <h2>{section.heading}</h2>
        {section.paragraphs.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
        {section.items && (
          <ul>
            {section.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        )}
      </section>
    ))
  }
</PageLayout>
