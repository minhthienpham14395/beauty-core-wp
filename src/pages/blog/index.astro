---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogCard from "../../components/blog/BlogCard.astro";
import BlogPagination from "../../components/blog/BlogPagination.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
);
const postsPerPage = 6;
const totalPages = Math.ceil(posts.length / postsPerPage);
const pagePosts = posts.slice(0, postsPerPage);
---

<BaseLayout
  title="Blog chăm sóc và thư giãn | Cô Năm Spa"
  description="Bài viết về gội đầu thư giãn, massage và những lưu ý khi trải nghiệm spa."
>
  <main class="blog-page container">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Trang chủ</a><span aria-hidden="true">/</span><span>Blog</span>
    </nav><header class="blog-header">
      <p class="section-label">Cẩm nang Cô Năm Spa</p><h1>Chăm sóc và thư giãn</h1><p>
        Những chia sẻ thực tế để bạn chuẩn bị tốt hơn trước và sau một buổi chăm sóc tại spa.
      </p>
    </header><div class="blog-grid">
      {pagePosts.map((post) => <BlogCard post={post} />)}
    </div><BlogPagination currentPage={1} totalPages={totalPages} />
  </main>
</BaseLayout>
