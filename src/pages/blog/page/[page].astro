---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import BlogCard from "../../../components/blog/BlogCard.astro";
import BlogPagination from "../../../components/blog/BlogPagination.astro";

const postsPerPage = 6;

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  const totalPages = Math.ceil(posts.length / 6);
  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, index) => ({
    params: { page: String(index + 2) },
  }));
}

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
);
const currentPage = Number(Astro.params.page);
const totalPages = Math.ceil(posts.length / postsPerPage);
const pagePosts = posts.slice((currentPage - 1) * postsPerPage, currentPage * postsPerPage);
---

<BaseLayout
  title={`Blog - Trang ${currentPage} | Cô Năm Spa`}
  description="Bài viết về gội đầu thư giãn, massage và những lưu ý khi trải nghiệm spa."
>
  <main class="blog-page container">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Trang chủ</a><span aria-hidden="true">/</span><a href="/blog/">Blog</a><span
        aria-hidden="true">/</span
      ><span>Trang {currentPage}</span>
    </nav>
    <header class="blog-header">
      <p class="section-label">Cẩm nang Cô Năm Spa</p><h1>Chăm sóc và thư giãn</h1><p>
        Trang {currentPage} trong các bài viết về chăm sóc và thư giãn.
      </p>
    </header>
    <div class="blog-grid">{pagePosts.map((post) => <BlogCard post={post} />)}</div>
    <BlogPagination currentPage={currentPage} totalPages={totalPages} />
  </main>
</BaseLayout>
