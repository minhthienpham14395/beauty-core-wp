---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Không tìm thấy trang | Cô Năm Spa"
  description="Trang bạn đang tìm không tồn tại hoặc đã được thay đổi địa chỉ."
  noindex={true}
>
  <main class="not-found container">
    <p class="section-label">Lỗi 404</p><h1>Không tìm thấy trang bạn cần</h1><p>
      Đường dẫn có thể đã thay đổi hoặc không còn tồn tại. Bạn có thể quay lại trang chủ, xem dịch
      vụ hoặc đọc các bài viết mới nhất.
    </p><div class="not-found__actions">
      <a href="/" class="btn btn-primary">Về trang chủ</a><a href="/blog/" class="btn btn-secondary"
        >Xem Blog</a
      >
    </div>
  </main>
</BaseLayout>
