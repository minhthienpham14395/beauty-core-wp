---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogCard from "../../components/blog/BlogCard.astro";
import { slugify } from "../../utils/slugify";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  const categories = [...new Set(posts.map((post) => post.data.category))];
  return categories.map((category) => ({
    params: { category: slugify(category) },
    props: { category, posts: posts.filter((post) => post.data.category === category) },
  }));
}

type Props = { category: string; posts: CollectionEntry<"blog">[] };
const { category, posts } = Astro.props;
---

<BaseLayout
  title={`${category} | Blog Cô Năm Spa`}
  description={`Các bài viết về ${category.toLowerCase()} tại Cô Năm Spa.`}
>
  <main class="blog-page container">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Trang chủ</a><span aria-hidden="true">/</span><a href="/blog/">Blog</a><span
        aria-hidden="true">/</span
      ><span>{category}</span>
    </nav><header class="blog-header">
      <p class="section-label">Danh mục Blog</p><h1>{category}</h1><p>
        Các bài viết tham khảo về chăm sóc và thư giãn tại Cô Năm Spa.
      </p>
    </header><div class="blog-grid">{posts.map((post) => <BlogCard post={post} />)}</div>
  </main>
</BaseLayout>
