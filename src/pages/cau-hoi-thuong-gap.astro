---
import PageLayout from "../layouts/PageLayout.astro";
import { bookingFaqs } from "../data/booking-faqs";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: bookingFaqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: { "@type": "Answer", text: faq.answer },
  })),
};
---

<PageLayout
  title="Câu hỏi thường gặp"
  description="Giải đáp về đặt lịch, thời lượng dịch vụ và những lưu ý trước khi đến Cô Năm Spa."
  updatedAt="13/07/2026"
>
  <section class="booking-faq article-faq" aria-label="Câu hỏi thường gặp về dịch vụ và đặt lịch">
    <p class="booking-faq__intro">
      Bạn có thể xem nhanh các thông tin phổ biến trước khi đặt lịch. Nếu cần hỗ trợ riêng, hãy liên
      hệ trực tiếp với Cô Năm Spa.
    </p>
    {
      bookingFaqs.map((faq) => (
        <details>
          <>
            <summary>{faq.question}</summary>
            <p>{faq.answer}</p>
          </>
        </details>
      ))
    }
  </section>
  <p><a class="btn btn-primary" href="/lien-he/">Liên hệ Cô Năm Spa</a></p>
</PageLayout>

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
